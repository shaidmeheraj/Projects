<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="3.9.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#TTL" name="6"/>
  <main name="main"/>
  <circuit name="main">
    <comp lib="0" name="Pin" loc="(50,50)">
      <a name="label" val="A1"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" name="Pin" loc="(50,90)">
      <a name="label" val="A2"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" name="Pin" loc="(50,130)">
      <a name="label" val="A3"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" name="Pin" loc="(50,170)">
      <a name="label" val="A4"/>
      <a name="output" val="true"/>
    </comp>

    <comp lib="0" name="Pin" loc="(50,210)">
      <a name="label" val="B1"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" name="Pin" loc="(50,250)">
      <a name="label" val="B2"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" name="Pin" loc="(50,290)">
      <a name="label" val="B3"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" name="Pin" loc="(50,330)">
      <a name="label" val="B4"/>
      <a name="output" val="true"/>
    </comp>

    <comp lib="6" name="74283" loc="(200,200)"/>

    <comp lib="5" name="LED" loc="(350,130)">
      <a name="label" val="S1"/>
    </comp>
    <comp lib="5" name="LED" loc="(350,170)">
      <a name="label" val="S2"/>
    </comp>
    <comp lib="5" name="LED" loc="(350,210)">
      <a name="label" val="S3"/>
    </comp>
    <comp lib="5" name="LED" loc="(350,250)">
      <a name="label" val="S4"/>
    </comp>
    <comp lib="5" name="LED" loc="(350,290)">
      <a name="label" val="Carry"/>
    </comp>

    <!-- Wires from A and B inputs to 74283 -->
    <wire from="(50,50)" to="(170,130)"/>
    <wire from="(50,90)" to="(170,150)"/>
    <wire from="(50,130)" to="(170,170)"/>
    <wire from="(50,170)" to="(170,190)"/>

    <wire from="(50,210)" to="(170,210)"/>
    <wire from="(50,250)" to="(170,230)"/>
    <wire from="(50,290)" to="(170,250)"/>
    <wire from="(50,330)" to="(170,270)"/>

    <!-- Wires from 74283 output to LEDs -->
    <wire from="(230,130)" to="(350,130)"/>
    <wire from="(230,150)" to="(350,170)"/>
    <wire from="(230,170)" to="(350,210)"/>
    <wire from="(230,190)" to="(350,250)"/>
    <wire from="(230,270)" to="(350,290)"/>
  </circuit>
</project>
